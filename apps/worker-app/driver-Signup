<body class="bg-surface text-on-surface min-h-screen flex flex-col items-center">
<!-- Top AppBar (Supressed for signup journey but using layout logic) -->
<header class="w-full flex justify-between items-center px-margin-mobile h-14 bg-surface sticky top-0 z-10">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary">arrow_back</span>
</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary">Lucky Delivery</div>
<div class="w-6"></div> <!-- Spacer for centering -->
</header>
<main class="w-full max-w-md px-margin-mobile flex flex-col gap-lg py-md pb-xl overflow-y-auto hide-scrollbar">
<!-- Header Branding & Steps -->
<section class="flex flex-col items-center gap-md">
<div class="w-20 h-20 bg-surface-container-low rounded-full flex items-center justify-center shadow-sm">
<img alt="Lucky Delivery Logo" class="w-14 h-14 object-contain" src="https://lh3.googleusercontent.com/aida/ADBb0uhqONRTF3rTinPcMQp0TqWup8WVtFF1HRLZ2R5OqKzXEJf4Nehh330h-xhdgqurMuXRXPQP9EoaflEwvoX2vVMEFl0r5op1paXWZ94hQXuP_G2ki_7VQGh_E8D22b-VdewHgUAYPym1B2WZtWQNgOjewq9VHDIZEj6e9AxtbnN_sWmycdBlHFDxf5sx7TA-PG8gkqddpGw_6D4ikTNFitF8XUAFqY79DC4F90iXYiQEdy2QT7UDGzuv-U8">
</div>
<!-- Step Indicator -->
<div class="flex items-center gap-sm">
<div class="flex items-center gap-xs">
<span class="w-2 h-2 rounded-full bg-primary-container"></span>
<span class="font-label-sm text-label-sm text-primary">Step 1</span>
</div>
<span class="text-outline-variant">•</span>
<span class="font-label-sm text-label-sm text-secondary">Step 2</span>
<span class="text-outline-variant">•</span>
<span class="font-label-sm text-label-sm text-secondary">Step 3</span>
</div>
<div class="text-center">
<h1 class="font-headline-md text-headline-md text-on-surface">Create Driver Account</h1>
<p class="font-body-md text-body-md text-on-surface-variant mt-xs">Join as a driver to start earning with Lucky Delivery</p>
</div>
</section>
<!-- Form Section -->
<form class="flex flex-col gap-md">
<!-- Full Name -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Full Name</label>
<input class="w-full h-14 bg-surface-container-low border-none rounded-xl px-md focus:ring-2 focus:ring-primary-container transition-all text-on-surface outline-none" placeholder="Enter your full name" required="" type="text">
</div>
<!-- Phone Number -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Phone Number</label>
<div class="relative flex items-center">
<span class="absolute left-md font-body-md text-on-surface-variant">+251</span>
<input class="w-full h-14 bg-surface-container-low border-none rounded-xl pl-20 pr-md focus:ring-2 focus:ring-primary-container transition-all text-on-surface outline-none" placeholder="911 123 456" required="" type="tel">
</div>
</div>
<!-- Email -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Email (Optional)</label>
<input class="w-full h-14 bg-surface-container-low border-none rounded-xl px-md focus:ring-2 focus:ring-primary-container transition-all text-on-surface outline-none" placeholder="example@mail.com" type="email">
</div>
<!-- Area / Neighborhood -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Area / Sub-city</label>
<div class="relative">
<select class="w-full h-14 bg-surface-container-low border-none rounded-xl px-md appearance-none focus:ring-2 focus:ring-primary-container transition-all text-on-surface outline-none" required="">
<option disabled="" selected="" value="">Select your area</option>
<option value="megenagna">Megenagna</option>
<option value="bole">Bole</option>
<option value="ayat">Ayat</option>
<option value="mexico">Mexico</option>
</select>
<span class="material-symbols-outlined absolute right-md top-1/2 -translate-y-1/2 pointer-events-none text-secondary">expand_more</span>
</div>
</div>
<!-- Vehicle Type -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Vehicle Type</label>
<div class="relative">
<select class="w-full h-14 bg-surface-container-low border-none rounded-xl px-md appearance-none focus:ring-2 focus:ring-primary-container transition-all text-on-surface outline-none" required="">
<option disabled="" selected="" value="">Select vehicle</option>
<option value="bike">Bike</option>
<option value="motorbike">Motorbike</option>
</select>
<span class="material-symbols-outlined absolute right-md top-1/2 -translate-y-1/2 pointer-events-none text-secondary">directions_bike</span>
</div>
</div>
<!-- Verification Section -->
<div class="pt-md border-t border-surface-variant flex flex-col gap-md">
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Upload ID Card</label>
<button class="w-full h-32 border-2 border-dashed border-outline-variant bg-surface-container-low rounded-xl flex flex-col items-center justify-center gap-xs hover:bg-surface-container transition-colors" type="button">
<span class="material-symbols-outlined text-primary text-[32px]">document_scanner</span>
<span class="font-label-sm text-label-sm text-secondary">Tap to upload ID</span>
</button>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md px-xs">Upload Profile Photo (Optional)</label>
<div class="flex gap-md">
<button class="w-24 h-24 bg-surface-container-low rounded-xl flex flex-col items-center justify-center border-2 border-dashed border-outline-variant hover:bg-surface-container transition-colors" type="button">
<span class="material-symbols-outlined text-secondary text-[24px]">photo_camera</span>
</button>
<div class="flex-1 flex flex-col justify-center"><p class="font-label-sm text-label-sm text-on-surface-variant">Take a live photo of your face for verification.</p></div>
</div>
</div>
<p class="text-center font-label-sm text-label-sm text-outline mt-sm">Your documents will be verified for approval</p>
</div>
</form>
<!-- Action Footer -->
<section class="flex flex-col gap-md pt-lg">
<button class="w-full h-14 bg-primary-container text-on-primary font-headline-sm rounded-xl shadow-lg hover:brightness-95 active:scale-95 transition-all flex items-center justify-center" type="submit">
                Continue
            </button>
<div class="text-center">
<p class="font-body-md text-body-md text-on-surface-variant">
                    Already have an account? 
                    <a class="text-primary-container font-bold hover:underline" href="#">Login</a>
</p>
</div>
</section>
<!-- Design System Compliant Spacer -->
<div class="h-xl"></div>
</main>
<!-- Map Context Decorator (Subtle background element) -->
